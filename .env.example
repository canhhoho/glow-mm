# ─────────────────────────────────────────────────────────────────────────────
# Mẫu biến môi trường. Copy thành `.env` (local) — KHÔNG commit file .env.
# Ba môi trường dùng chung code, chỉ khác giá trị:
#   [LOCAL]  máy dev + docker compose
#   [VERCEL] testing: Vercel (functions region sin1) + Neon Singapore
#   [MM]     production: server Myanmar, Coolify + Docker
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL chuẩn (không dùng tính năng riêng của nhà cung cấp).
# [LOCAL]  postgresql://glow:glow@localhost:55432/glow
# [VERCEL] chuỗi kết nối POOLED của Neon (có -pooler), ?sslmode=require
#          Preview và Production dùng 2 database/branch Neon khác nhau.
# [MM]     postgresql://glow:<mật-khẩu>@db:5432/glow (service trong Coolify)
DATABASE_URL=postgresql://glow:glow@localhost:55432/glow
# Kết nối TRỰC TIẾP cho `prisma migrate` (để trống = dùng DATABASE_URL).
# [VERCEL] chuỗi Neon KHÔNG có -pooler.  [LOCAL]/[MM] để trống.
DIRECT_DATABASE_URL=

# URL gốc của app (không có / ở cuối). Dùng cho auth, link sản phẩm, email…
# [LOCAL] http://localhost:3000  [VERCEL] https://<project>.vercel.app  [MM] https://<domain>
APP_URL=http://localhost:3000

# Secret phiên đăng nhập (>= 32 ký tự). Mỗi môi trường một giá trị khác nhau.
# Tạo: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-secret-value

# Bảo vệ /api/cron/* (header Authorization: Bearer <CRON_SECRET>). >= 16 ký tự.
# [VERCEL] Vercel Cron tự gửi header khi biến CRON_SECRET được đặt trong project.
# [MM]     crontab/Coolify gọi bằng curl kèm header.
CRON_SECRET=change-me-cron-secret

# Lưu file: vercel-blob | local
# [LOCAL]/[MM] local   [VERCEL] vercel-blob
STORAGE_DRIVER=local
# Bắt buộc khi STORAGE_DRIVER=vercel-blob (Vercel tự tạo khi gắn Blob store).
BLOB_READ_WRITE_TOKEN=
# Thư mục lưu file khi STORAGE_DRIVER=local. [MM] mount volume vào đây (vd /app/storage).
LOCAL_STORAGE_DIR=./storage

# Nút "Hỏi qua Messenger/Viber" (để trống = ẩn nút).
# FB_PAGE_USERNAME: phần sau m.me/  — VIBER_CHAT_URI: vd viber://chat?number=%2B959xxxxxxx
FB_PAGE_USERNAME=
VIBER_CHAT_URI=

# Chỉ dùng cho `npm run db:seed` (tạo tài khoản nhân viên mẫu). KHÔNG đặt ở production.
SEED_STAFF_PASSWORD=ChangeMe123!
