# ─────────────────────────────────────────────────────────────────────────────
# Mẫu biến môi trường. Copy thành `.env` (local) — KHÔNG commit file .env.
# Hai môi trường dùng chung code, chỉ khác giá trị (Vercel/Neon đã bỏ hẳn 19/11/2026):
#   [LOCAL]  máy dev + docker compose
#   [MM]     production: server tandcstore.com, Docker Compose + Nginx (docker-compose.prod.yml, file .env.prod)
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL chuẩn (không dùng tính năng riêng của nhà cung cấp).
# [LOCAL]  postgresql://glow:glow@localhost:15432/glow
# [MM]     postgresql://glow:<mật-khẩu>@db:5432/glow (service db trong docker-compose.prod.yml)
DATABASE_URL=postgresql://glow:glow@localhost:15432/glow
# Kết nối TRỰC TIẾP cho `prisma migrate` (để trống = dùng DATABASE_URL). [LOCAL]/[MM] để trống.
DIRECT_DATABASE_URL=

# D5: sự kiện nội bộ, không script ngoài. false = tắt ghi sự kiện và client collector.
ANALYTICS_ENABLED=true
# Số ngày giữ sự kiện (1–730); job cleanup dọn sau hạn. Cần xác minh chính sách lưu dữ liệu khi vận hành.
ANALYTICS_RETENTION_DAYS=180
# Số kết nối tối đa của pool pg trong app (mặc định 10).
# [LOCAL] để trống.  [MM] 20 (Postgres mặc định cho 100 kết nối).
DATABASE_POOL_MAX=

# URL gốc của app (không có / ở cuối). Dùng cho auth, link sản phẩm, email, SEO (canonical, hreflang, Open Graph, sitemap).
# Cần có cả LÚC BUILD (metadata tĩnh): Docker truyền build arg APP_URL (docker-compose.prod.yml đã làm).
# [LOCAL] http://localhost:3000  [MM] https://<domain>
APP_URL=http://localhost:3000

# Secret phiên đăng nhập (>= 32 ký tự). Mỗi môi trường một giá trị khác nhau.
# Tạo: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-secret-value

# Bảo vệ /api/cron/* (header Authorization: Bearer <CRON_SECRET>). >= 16 ký tự.
# [MM] crontab trên host gọi bằng curl kèm header (ops/cron.example).
CRON_SECRET=change-me-cron-secret

# Lưu file: hiện chỉ có `local` (ổ đĩa). Giá trị cũ vercel-blob đã bỏ.
STORAGE_DRIVER=local
# Thư mục lưu file. [MM] mount volume vào đây (vd /app/storage).
LOCAL_STORAGE_DIR=./storage

# Nút "Hỏi qua Messenger/Viber" (để trống = ẩn nút).
# FB_PAGE_USERNAME: phần sau m.me/  — VIBER_CHAT_URI: vd viber://chat?number=%2B959xxxxxxx
FB_PAGE_USERNAME=
VIBER_CHAT_URI=

# ── Tài khoản khách (P14) ──
# Gửi email xác minh / đặt lại mật khẩu cho khách: none | outbox | resend
#   none   = tắt đăng ký & đăng nhập khách bằng email (còn SĐT + mật khẩu; quên mật khẩu → yêu cầu chờ admin xác nhận).
#   outbox = không gửi thật, ghi file JSON vào EMAIL_OUTBOX_DIR + log (dev, E2E).
#   resend = gửi qua Resend (cần tên miền đã xác minh SPF/DKIM).
# [LOCAL] outbox   [MM] resend
EMAIL_DRIVER=outbox
# Bắt buộc khi EMAIL_DRIVER=resend. EMAIL_FROM vd: "T&C Cosmetics <no-reply@<tên-miền>>"
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_OUTBOX_DIR=./storage/outbox
# Đăng nhập Google cho khách: đã gỡ khỏi code (14/11/2026), sẽ làm lại sau — không còn biến GOOGLE_CLIENT_*.

# Chỉ dùng cho `npm run db:seed` (tạo tài khoản nhân viên mẫu). KHÔNG đặt ở production.
SEED_STAFF_PASSWORD=ChangeMe123!
