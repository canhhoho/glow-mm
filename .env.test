# Giá trị CHỈ dùng cho test tự động trên máy local/CI (không phải secret thật).
DATABASE_URL=postgresql://glow:glow@localhost:15432/glow_test
# Để trống có chủ đích: không cho prisma CLI trỏ nhầm sang DB khác khi chạy test.
DIRECT_DATABASE_URL=
APP_URL=http://localhost:3100
BETTER_AUTH_SECRET=test-only-secret-not-for-production-000000
CRON_SECRET=test-only-cron-secret
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage-test
SEED_STAFF_PASSWORD=TestPass123!
# Email khách (P14): ghi ra file để test đọc link xác minh/đặt lại mật khẩu.
EMAIL_DRIVER=outbox
EMAIL_OUTBOX_DIR=./storage-test/outbox
