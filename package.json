{
  "name": "glow-mm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:demo": "tsx --conditions=react-server scripts/seed-demo.ts",
    "db:seed:placeholders": "tsx --conditions=react-server scripts/seed-placeholders.ts",
    "seed:preview": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/seed-preview.ps1",
    "db:reset": "prisma migrate reset --force",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test:unit",
    "test": "npm run lint && npm run typecheck && npm run test:unit && npm run test:int && npm run test:e2e",
    "postinstall": "prisma generate",
    "vercel-build": "prisma migrate deploy && next build",
    "test:int": "vitest run -c vitest.integration.config.mts",
    "perf": "node scripts/lighthouse.mjs",
    "data:check": "tsx scripts/data-checks.ts",
    "perf:bulk-review": "tsx --conditions=react-server scripts/perf-bulk-review.ts",
    "i18n:export": "tsx scripts/i18n-export.ts",
    "i18n:import": "tsx scripts/i18n-import.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@vercel/blob": "2.8.2",
    "better-auth": "1.7.9",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "fflate": "0.8.3",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "next-intl": "4.14.9",
    "pg": "8.23.1",
    "rabbit-node": "1.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "9.3.14",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource/noto-sans-myanmar": "5.3.0",
    "@neondatabase/serverless": "1.2.0",
    "@playwright/test": "1.64.1",
    "@prisma/adapter-neon": "7.10.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "lighthouse": "13.5.0",
    "prisma": "7.10.1",
    "shadcn": "^4.21.5",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=24.12 <25"
  }
}
