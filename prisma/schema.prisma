// Data model — xem PLAN.md §2.
// Quy ước: tiền = Int (MMK, VND), tỷ giá = Decimal, thời gian = UTC.
// Tồn kho CHỈ thay đổi qua StockDocument → StockLedger (+ StockBalance cùng transaction).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Auth (Better Auth) & hệ thống ─────────────────────────

enum Role {
  ADMIN
  WAREHOUSE_MANAGER
  ORDER_STAFF
  /// Cộng tác viên bán hàng (P10): chỉ vào cổng /ctv, không vào /admin.
  AFFILIATE
  /// Khách hàng tự đăng ký trên storefront (P14): chỉ dùng instance auth khách (/api/customer-auth).
  CUSTOMER
}

model User {
  id                  String           @id
  name                String
  email               String           @unique
  emailVerified       Boolean          @default(false)
  /// Khách đăng ký bằng SĐT + mật khẩu (P17, plugin phoneNumber của Better Auth): lưu dạng chuẩn 09xxxxxxxx.
  /// Tài khoản SĐT không có email thật → `email` là địa chỉ nội bộ <SĐT>@phone.glow.invalid (không bao giờ gửi mail).
  phoneNumber         String?          @unique
  /// Luôn false (không có OTP) — SĐT chưa xác minh nên KHÔNG dùng để gắn đơn cũ.
  phoneNumberVerified Boolean?         @default(false)
  image               String?
  /// Mặc định quyền thấp nhất; nhân viên/CTV luôn được tạo với role tường minh.
  role                Role             @default(CUSTOMER)
  locale              String           @default("vi")
  active              Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  sessions            Session[]
  accounts            Account[]
  affiliate           Affiliate?
  /// Tài khoản khách (P14): đơn thuộc tài khoản + sổ địa chỉ.
  orders              Order[]          @relation("AccountOrders")
  addresses           AccountAddress[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Bộ đếm chống dò mật khẩu của Better Auth (dùng chung mọi instance serverless).
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

/// Bộ đếm của instance auth khách (P14) — tách bảng vì khoá `ip|path` trùng với instance nhân viên.
model CustomerRateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("customerRateLimit")
}

/// Bộ đếm tự viết (`hitRateLimit`: đăng nhập theo SĐT/email, đăng ký, tra cứu đơn…). Tách khỏi `rateLimit` vì
/// Better Auth xoá mọi dòng cũ hơn cửa sổ dài nhất của nó (60s) trong bảng đó → cửa sổ 10 phút/1 giờ bị xoá sớm.
model AppRateLimit {
  key         String @id
  count       Int
  windowStart BigInt

  @@map("appRateLimit")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

/// Cấu hình key/value: expiry.blockDays, expiry.warnDays, reservation.transferHours, cod.confirmHours…
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum StorageDriver {
  VERCEL_BLOB
  LOCAL
}

enum FileVisibility {
  PUBLIC
  /// Chỉ nhân viên có quyền mới tải được (biên lai chuyển khoản).
  PRIVATE
}

model FileObject {
  id             String            @id @default(cuid())
  driver         StorageDriver
  key            String            @unique
  url            String
  mime           String
  size           Int
  visibility     FileVisibility    @default(PUBLIC)
  createdAt      DateTime          @default(now())
  productImages  ProductImage[]
  paymentProofs  PaymentProof[]
  payoutProofs   AffiliatePayout[]
  categoryIcons  Category[]
  bannersDesktop Banner[]          @relation("BannerDesktop")
  bannersMobile  Banner[]          @relation("BannerMobile")
}

// ───────────────────────── Catalog ─────────────────────────

model Brand {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  origin   String?
  products Product[]
}

model Category {
  id            String                 @id @default(cuid())
  slug          String                 @unique
  parentId      String?
  parent        Category?              @relation("CategoryTree", fields: [parentId], references: [id])
  children      Category[]             @relation("CategoryTree")
  sortOrder     Int                    @default(0)
  /// Icon ô "nhóm hàng" trên trang chủ (ảnh vuông PNG/WebP/JPG).
  iconFileId    String?
  icon          FileObject?            @relation(fields: [iconFileId], references: [id])
  translations  CategoryTranslation[]
  products      Product[]
  slugRedirects CategorySlugRedirect[]
}

/// Slug cũ của danh mục đã đổi slug → /c/<slug cũ> chuyển 308 sang slug hiện tại (trỏ theo id nên đổi nhiều lần không thành chuỗi).
model CategorySlugRedirect {
  slug       String   @id
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([categoryId])
}

model CategoryTranslation {
  categoryId String
  locale     String
  name       String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([categoryId, locale])
}

/// Thuộc tính lọc: loại da, vấn đề da, thành phần.
enum TagKind {
  SKIN_TYPE
  CONCERN
  INGREDIENT
}

model Tag {
  id           String           @id @default(cuid())
  kind         TagKind
  slug         String
  translations TagTranslation[]
  products     ProductTag[]

  @@unique([kind, slug])
}

model TagTranslation {
  tagId  String
  locale String
  name   String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([tagId, locale])
}

model Product {
  requiresExpiry Boolean              @default(true)
  /// Period after opening; separate from batch expiry.
  paoMonths      Int?
  id             String               @id @default(cuid())
  slug           String               @unique
  brandId        String
  brand          Brand                @relation(fields: [brandId], references: [id])
  categoryId     String
  category       Category             @relation(fields: [categoryId], references: [id])
  /// Kho bán của SP (P24): nhận hàng, tồn bán, xuất đơn và cách tính giá đều theo kho này.
  stockLocationId String
  stockLocation  Location             @relation(fields: [stockLocationId], references: [id])
  /// Lãi cố định MMK/đơn vị — kho LOCAL_MMK: giá = vốn MMK + lãi này (P24).
  fixedProfitMmk Int?
  storageNote    String?
  published      Boolean              @default(false)
  /// Ngừng kinh doanh: SP đã có lịch sử kho/đơn nên không xoá hẳn được — ẩn khỏi web, danh sách mặc định và form nhập kho.
  archivedAt     DateTime?
  /// QT2 — bước 4 Duyệt: thời điểm + người duyệt (null = hệ thống, lúc chuyển đổi) + dấu vân tay nội dung/giá đã duyệt.
  /// Đổi nội dung/giá/ảnh sau khi duyệt → approvedAt = null, giữ approvedHash ("cần duyệt lại").
  approvedAt     DateTime?
  approvedById   String?
  approvedHash   String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  translations   ProductTranslation[]
  tags           ProductTag[]
  images         ProductImage[]
  variants       Variant[]
  reviews        Review[]
  collections    CollectionItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([stockLocationId])
}

model ProductTranslation {
  productId       String
  locale          String
  name            String
  description     String?
  usage           String?
  ingredientsText String?
  /// Bản chuẩn hoá để tìm kiếm (lowercase, Unicode).
  searchText      String
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, locale])
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model ProductImage {
  id        String     @id @default(cuid())
  productId String
  fileId    String
  sortOrder Int        @default(0)
  alt       String?
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  file      FileObject @relation(fields: [fileId], references: [id])

  @@index([productId, sortOrder])
}

model Variant {
  id            String              @id @default(cuid())
  productId     String
  product       Product             @relation(fields: [productId], references: [id])
  sku           String              @unique
  /// Tên biến thể (dung tích / màu), ví dụ "50ml", "#21 Light".
  label         String
  priceMmk      Int
  weightGrams   Int?
  isBundle      Boolean             @default(false)
  active        Boolean             @default(true)
  /// Thời gian VN→MM (ngày) cho gợi ý đặt hàng.
  leadTimeDays  Int                 @default(21)
  safetyStock   Int                 @default(0)
  lowStockAt    Int                 @default(5)
  /// Hoa hồng CTV cố định (MMK/cái) cho biến thể này; null = tính theo % của CTV, 0 = không hoa hồng.
  affiliateCommissionMmk Int?
  bundleItems   BundleItem[]        @relation("BundleParent")
  componentOf   BundleItem[]        @relation("BundleComponent")
  batches       Batch[]
  reservations  Reservation[]
  orderItems    OrderItem[]
  priceHistory  PriceHistory[]
  priceRunLines PriceRunLine[]
  documentLines StockDocumentLine[]

  @@index([productId])
}

model BundleItem {
  bundleId    String
  componentId String
  qty         Int
  bundle      Variant @relation("BundleParent", fields: [bundleId], references: [id], onDelete: Cascade)
  component   Variant @relation("BundleComponent", fields: [componentId], references: [id])

  @@id([bundleId, componentId])
}

// ───────────────────────── Giá ─────────────────────────

model ExchangeRate {
  id          String           @id @default(cuid())
  /// Số MMK cho 1 VND. Tỷ giá nhập qua USD (P23): giá trị tính sẵn (làm tròn 6 số lẻ) — công thức dùng 2 cột USD cho chính xác.
  mmkPerVnd   Decimal          @db.Decimal(14, 6)
  /// 1 USD = ? MMK (P23). Null = tỷ giá cũ nhập thẳng MMK/VND.
  mmkPerUsd   Decimal?         @db.Decimal(14, 2)
  /// 1 USD = ? VND (P23).
  vndPerUsd   Decimal?         @db.Decimal(14, 2)
  effectiveAt DateTime         @default(now())
  note        String?
  createdById String
  createdAt   DateTime         @default(now())
  priceRuns   PriceUpdateRun[]
  batches     Batch[]

  @@index([effectiveAt])
}

enum PriceRunStatus {
  PREVIEW
  APPLIED
  CANCELLED
}

/// D1: trạng thái từng dòng — áp dụng một phần thì bản xem trước vẫn mở cho dòng còn chờ.
enum PriceLineStatus {
  PENDING
  APPLIED
  SKIPPED
}

model PriceUpdateRun {
  id           String         @id @default(cuid())
  /// Kho được tính giá (P24); null = bản tính giá cũ trước khi có 2 kho.
  locationId   String?
  location     Location?      @relation(fields: [locationId], references: [id])
  /// Chỉ kho VN_IMPORT: tỷ giá + % lãi + đơn giá ship MMK/kg.
  rateId       String?
  rate         ExchangeRate?  @relation(fields: [rateId], references: [id])
  marginPct    Decimal?       @db.Decimal(6, 2)
  shipMmkPerKg Int?
  roundTo      Int            @default(100)
  status      PriceRunStatus @default(PREVIEW)
  createdById String
  createdAt   DateTime       @default(now())
  /// Lần áp dụng gần nhất (bản áp một phần vẫn PREVIEW đến khi hết dòng chờ).
  appliedAt   DateTime?
  /// D1: 1 = bản cũ (lô theo ngày tạo, không fingerprint); 2 = nguồn từ phiếu nhập đã ghi sổ + fingerprint.
  formulaVersion Int        @default(1)
  /// Hết hạn áp dụng; null = bản tạo trước D1 → coi như hết hạn, phải tạo lại.
  expiresAt   DateTime?
  /// Biến thể bị bỏ qua khi tạo bản xem trước: [{ variantId, sku, reason }].
  skipped     Json?
  history     PriceHistory[]
  lines       PriceRunLine[]
}

/// Dòng xem trước của một lần cập nhật giá — áp dụng đúng số đã xem (không tính lại).
model PriceRunLine {
  id          String         @id @default(cuid())
  runId       String
  run         PriceUpdateRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  variantId   String
  variant     Variant        @relation(fields: [variantId], references: [id])
  /// Vốn dùng để tính (lô nhập gần nhất; combo = tổng thành phần): VND (Kho VN_IMPORT) hoặc MMK (LOCAL_MMK).
  costVnd     Int?
  costMmk     Int?
  /// VN_IMPORT: phí ship = đơn giá × khối lượng; LOCAL_MMK: lãi cố định của SP.
  shipMmk     Int?
  profitMmk   Int?
  oldPriceMmk Int
  newPriceMmk Int
  /// D1: Chờ / Đã áp / Bỏ qua (`skipReason`: UNCHANGED, PRICE_CHANGED, INPUT_CHANGED, CANCELLED, LEGACY).
  status      PriceLineStatus @default(PENDING)
  skipReason  String?
  appliedAt   DateTime?
  /// Nguồn giá mua (biến thể thường): lô + phiếu nhập đã ghi sổ được chọn. Combo: null (xem thành phần).
  sourceBatchId    String?
  sourceBatch      Batch?         @relation(fields: [sourceBatchId], references: [id])
  sourceDocumentId String?
  sourceDocument   StockDocument? @relation(fields: [sourceDocumentId], references: [id])
  sourcePostedAt   DateTime?
  /// Khối lượng dùng tính cước/kg (VN_IMPORT); `weightFromComponents` = combo chưa khai báo → cộng thành phần.
  weightGrams          Int?
  weightFromComponents Boolean @default(false)
  /// Băm đầu vào của dòng (nguồn giá, khối lượng, combo, lãi cố định…) — áp dụng tính lại, khác thì bỏ qua.
  fingerprint String?

  @@unique([runId, variantId])
}

model PriceHistory {
  id          String          @id @default(cuid())
  variantId   String
  variant     Variant         @relation(fields: [variantId], references: [id])
  oldPriceMmk Int
  newPriceMmk Int
  runId       String?
  run         PriceUpdateRun? @relation(fields: [runId], references: [id])
  reason      String?
  userId      String
  createdAt   DateTime        @default(now())

  @@index([variantId, createdAt])
}

// ───────────────────────── Kho ─────────────────────────

model Warehouse {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  country   String
  locations Location[]
}

enum LocationType {
  VN_STOCK
  IN_TRANSIT
  CUSTOMS
  MM_STOCK
  QUARANTINE
}

/// Cách tính giá bán của kho bán (P24).
enum PricingMode {
  /// Kho Thắm: vốn VND × tỷ giá × (1 + % lãi) + ship MMK/kg × khối lượng.
  VN_IMPORT
  /// Kho Chi: vốn MMK của lô mới nhất + lãi cố định MMK theo sản phẩm.
  LOCAL_MMK
}

model Location {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  type        LocationType
  warehouseId String?
  warehouse   Warehouse?      @relation(fields: [warehouseId], references: [id])
  /// Kho bán (MM_STOCK): tồn ở đây bán cho các SP thuộc kho này (`Product.stockLocationId`).
  sellable    Boolean         @default(false)
  /// Tắt = ẩn khỏi mọi ô chọn kho, không nhận phiếu mới (không xoá được vì sổ kho tham chiếu).
  active      Boolean         @default(true)
  pricingMode PricingMode?
  ledger      StockLedger[]
  balances    StockBalance[]
  docsFrom    StockDocument[] @relation("DocFrom")
  docsTo      StockDocument[] @relation("DocTo")
  products    Product[]
  priceRuns   PriceUpdateRun[]
  pickLines   OrderPickLine[]
}

enum AllocationMethod {
  BY_VALUE
  BY_QTY
  BY_WEIGHT
}

/// Chuyến hàng VN→MM, gom chi phí để phân bổ landed cost.
model InboundShipment {
  id               String           @id @default(cuid())
  code             String           @unique
  allocationMethod AllocationMethod @default(BY_VALUE)
  departedAt       DateTime?
  arrivedAt        DateTime?
  note             String?
  createdAt        DateTime         @default(now())
  costs            ShipmentCost[]
  batches          Batch[]
  documents        StockDocument[]
  allocations      ShipmentAllocation[]
}

model ShipmentAllocation {
  id           String @id @default(cuid())
  shipmentId   String
  shipment     InboundShipment @relation(fields: [shipmentId], references: [id])
  createdAt    DateTime @default(now())
  createdById  String
  method       AllocationMethod
  fingerprint  String
  input        Json
  result       Json

  @@index([shipmentId, createdAt])
}

enum ShipmentCostType {
  SHIPPING
  TAX
  FEE
}

model ShipmentCost {
  id         String           @id @default(cuid())
  shipmentId String
  shipment   InboundShipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  type       ShipmentCostType
  amountVnd  Int
  note       String?
}

enum ExpiryStatus {
  DATED
  NONE
  UNKNOWN
}

model CatalogOpeningImport {
  id        String   @id
  createdAt DateTime @default(now())
  userId    String
  result    Json
}

model Batch {
  id            String              @id @default(cuid())
  variantId     String
  variant       Variant             @relation(fields: [variantId], references: [id])
  lotNo         String
  mfgDate       DateTime?           @db.Date
  expiryDate    DateTime?           @db.Date
  expiryStatus  ExpiryStatus        @default(DATED)
  /// Giá mua/đơn vị — đúng một trong hai (CHECK ở DB, P24): VND (hàng nhập VN) hoặc MMK (hàng mua tại Myanmar).
  /// Lô MMK: `landedCostMmk = unitCostMmk` ngay khi tạo (không cần tỷ giá, không phân bổ chuyến hàng).
  unitCostVnd   Int?
  unitCostMmk   Int?
  /// Giá vốn đã cộng chi phí phân bổ (VND/đơn vị).
  landedCostVnd Int?
  rateId        String?
  rate          ExchangeRate?       @relation(fields: [rateId], references: [id])
  landedCostMmk Int?
  /// Giá vốn tạm tính MMK, chụp khi ghi sổ; không ghi đè giá vốn thực tế.
  estimatedCostMmk Int?
  estimatedShipMmkPerKg Int?
  estimatedWeightGrams Int?
  shipmentId    String?
  shipment      InboundShipment?    @relation(fields: [shipmentId], references: [id])
  createdAt     DateTime            @default(now())
  ledger        StockLedger[]
  balances      StockBalance[]
  allocations   OrderAllocation[]
  documentLines StockDocumentLine[]
  priceRunLines PriceRunLine[]
  pickLines     OrderPickLine[]

  @@unique([variantId, lotNo])
  @@index([variantId, expiryDate])
}

enum StockType {
  SELLABLE
  TESTER
}

enum DocType {
  RECEIVE
  TRANSFER
  ISSUE
  ADJUST
  RETURN
}

enum DocStatus {
  DRAFT
  POSTED
  CANCELLED
}

model StockDocument {
  id          String              @id @default(cuid())
  code        String              @unique
  type        DocType
  status      DocStatus           @default(DRAFT)
  fromId      String?
  from        Location?           @relation("DocFrom", fields: [fromId], references: [id])
  toId        String?
  to          Location?           @relation("DocTo", fields: [toId], references: [id])
  shipmentId  String?
  shipment    InboundShipment?    @relation(fields: [shipmentId], references: [id])
  orderId     String?
  order       Order?              @relation(fields: [orderId], references: [id])
  reason      String?
  estimatedShipMmkPerKg Int?
  createdById String
  postedById  String?
  createdAt   DateTime            @default(now())
  postedAt    DateTime?
  lines       StockDocumentLine[]
  priceRunLines PriceRunLine[]
  ledger      StockLedger[]

  @@index([type, status])
  @@index([orderId])
}

model StockDocumentLine {
  id         String        @id @default(cuid())
  documentId String
  document   StockDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  variantId  String
  variant    Variant       @relation(fields: [variantId], references: [id])
  /// Null khi phiếu xuất để hệ thống tự chọn lô theo FEFO.
  batchId    String?
  batch      Batch?        @relation(fields: [batchId], references: [id])
  stockType  StockType     @default(SELLABLE)
  /// Với ADJUST có thể âm.
  qty        Int

  @@index([documentId])
}

/// Sổ cái — chỉ INSERT, không UPDATE/DELETE.
model StockLedger {
  id         String        @id @default(cuid())
  documentId String
  document   StockDocument @relation(fields: [documentId], references: [id])
  batchId    String
  batch      Batch         @relation(fields: [batchId], references: [id])
  locationId String
  location   Location      @relation(fields: [locationId], references: [id])
  stockType  StockType
  qtyDelta   Int
  userId     String
  createdAt  DateTime      @default(now())

  @@index([batchId, locationId])
  @@index([createdAt])
  @@index([documentId])
}

/// Tổng hợp từ ledger, cập nhật trong cùng transaction.
model StockBalance {
  batchId    String
  locationId String
  stockType  StockType
  qty        Int
  batch      Batch     @relation(fields: [batchId], references: [id])
  location   Location  @relation(fields: [locationId], references: [id])

  @@id([batchId, locationId, stockType])
  @@index([locationId])
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

model Reservation {
  id        String            @id @default(cuid())
  variantId String
  variant   Variant           @relation(fields: [variantId], references: [id])
  orderId   String
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  qty       Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime?
  createdAt DateTime          @default(now())

  @@unique([orderId, variantId])
  @@index([variantId, status])
  @@index([status, expiresAt])
}

// ───────────────────────── Bán hàng ─────────────────────────

model Customer {
  id        String    @id @default(cuid())
  /// Chuẩn hoá dạng 09xxxxxxxx.
  phone     String    @unique
  name      String
  createdAt DateTime  @default(now())
  addresses Address[]
  orders    Order[]
}

model Address {
  id         String      @id @default(cuid())
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  /// Thị trấn VTP (P15). Null = địa chỉ cũ trước P15 không khớp danh mục VTP.
  townshipId String?
  township   MmTownship? @relation(fields: [townshipId], references: [id])
  line       String
  note       String?
  orders     Order[]

  @@index([customerId])
}

/// Sổ địa chỉ của tài khoản khách (P14) — tự điền khi thanh toán. Tách khỏi Address (gắn theo SĐT, snapshot đơn).
model AccountAddress {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName String
  /// SĐT đã chuẩn hoá 09xxxxxxxx; `phone2` = SĐT phụ (P15, không bắt buộc).
  phone         String
  phone2        String?
  townshipId    String
  township      MmTownship @relation(fields: [townshipId], references: [id])
  line          String
  note          String?
  isDefault     Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([userId])
}

/// Vùng giao hàng (region/township).
/// Danh mục địa chỉ người nhận theo VTP Myanmar (P15): Liên bang/Vùng → Huyện → Thị trấn.
/// Dữ liệu chèn bằng migration từ prisma/data/vtp-myanmar-addresses.json; id ổn định (st-YGN, ds-YGN-WYG, tw-YGN-WYG-KMY).
/// Mã VTP không duy nhất toàn cục → unique theo cấp cha. `nameMy` là bản nháp [CẦN XÁC MINH], admin sửa được.
/// `active = false` → không còn trong form chọn địa chỉ (tạm ngừng giao).
model MmState {
  id        String       @id
  code      String       @unique
  nameEn    String
  nameMy    String
  sortOrder Int          @default(0)
  active    Boolean      @default(true)
  districts MmDistrict[]
}

model MmDistrict {
  id        String       @id
  stateId   String
  state     MmState      @relation(fields: [stateId], references: [id])
  code      String
  nameEn    String
  nameMy    String
  sortOrder Int          @default(0)
  active    Boolean      @default(true)
  townships MmTownship[]

  @@unique([stateId, code])
}

model MmTownship {
  id               String           @id
  districtId       String
  district         MmDistrict       @relation(fields: [districtId], references: [id])
  code             String
  nameEn           String
  nameMy           String
  sortOrder        Int              @default(0)
  active           Boolean          @default(true)
  addresses        Address[]
  accountAddresses AccountAddress[]
  orders           Order[]

  @@unique([districtId, code])
}

enum OrderStatus {
  PENDING
  PAYMENT_CONFIRMED
  COD_CONFIRMED
  PACKING
  SHIPPING
  COMPLETED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  BANK_TRANSFER
}

enum ShippingPayer {
  RECEIVER
  SENDER
}

/// Sự kiện đo hành vi: mã phiên ngẫu nhiên, đường dẫn đã bỏ chi tiết và không lưu thông tin khách.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  name       String
  occurredAt DateTime @default(now())
  sessionId  String
  locale     String?
  device     String?
  path       String?
  orderId    String?
  dedupeKey  String? @unique
  props      Json?

  @@index([name, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([occurredAt])
}

enum PaymentStatus {
  UNPAID
  PROOF_SUBMITTED
  PAID
  REJECTED
  REFUNDED
}

enum OrderChannel {
  WEB
  FACEBOOK
  VIBER
  PHONE
}

model Order {
  id                String                @id @default(cuid())
  code              String                @unique
  customerId        String
  customer          Customer              @relation(fields: [customerId], references: [id])
  addressId         String
  address           Address               @relation(fields: [addressId], references: [id])
  /// Snapshot lúc đặt — sửa khách/địa chỉ sau này không đổi đơn cũ.
  recipientName     String
  recipientPhone    String
  /// SĐT phụ người nhận (P15, không bắt buộc).
  recipientPhone2   String?
  addressText       String
  /// Chuỗi hiển thị "Thị trấn, Huyện, Vùng" (đơn trước P15: "tên Myanmar / tên Anh" của khu vực cũ).
  zoneName          String
  /// Thị trấn VTP + mã VTP 3 cấp chốt lúc đặt (P15) — để đẩy/xuất đơn sang VTP sau này.
  townshipId        String?
  township          MmTownship?           @relation(fields: [townshipId], references: [id])
  stateCode         String?
  districtCode      String?
  townshipCode      String?
  channel           OrderChannel          @default(WEB)
  status            OrderStatus           @default(PENDING)
  paymentMethod     PaymentMethod
  shippingPayer     ShippingPayer @default(RECEIVER)
  paymentStatus     PaymentStatus         @default(UNPAID)
  subtotalMmk       Int
  /// Từ P15 luôn 0: phí ship do đơn vị vận chuyển (VTP) thu trực tiếp khi giao. Đơn cũ giữ phí đã chốt.
  shippingFeeMmk    Int
  totalMmk          Int
  locale            String                @default("my")
  note              String?
  cancelReason      String?
  /// Chống tạo trùng khi bấm gửi 2 lần.
  idempotencyKey    String?               @unique
  codConfirmedAt    DateTime?
  /// COD khách đã thanh toán cho đơn vị vận chuyển; khác thời điểm tiền về cửa hàng.
  codCollectedAt    DateTime?
  codRemittedAt     DateTime?
  codRemittedMmk    Int?
  codCarrierFeeMmk  Int?
  codRemittanceRef  String?
  codAdjustmentMmk  Int?
  codSettlementNote String?
  /// Thời điểm chuyển sang COMPLETED — mốc tính hạn giữ hoa hồng CTV.
  completedAt       DateTime?
  createdById       String?
  /// CTV được tính đơn này (P10) + nguồn gắn + % hoa hồng chốt lúc gắn (phần vạn: 1000 = 10%).
  affiliateId       String?
  affiliate         Affiliate?            @relation(fields: [affiliateId], references: [id])
  affiliateSource   AffiliateSource?
  commissionRateBp  Int?
  /// Cấp trên của CTV chốt lúc gắn CTV (P11) + % tầng trên (phần vạn). Đổi tuyến sau không ảnh hưởng đơn cũ.
  uplineAffiliateId String?
  uplineAffiliate   Affiliate?            @relation("OrderUpline", fields: [uplineAffiliateId], references: [id])
  uplineRateBp      Int?
  /// Tài khoản khách sở hữu đơn (P14): đặt khi đăng nhập hoặc nhận lại đơn cũ (mã + SĐT). Null = khách vãng lai / đơn ngoài web.
  accountId         String?
  account           User?                 @relation("AccountOrders", fields: [accountId], references: [id], onDelete: SetNull)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  items             OrderItem[]
  reservations      Reservation[]
  history           OrderStatusHistory[]
  paymentProofs     PaymentProof[]
  deliveries        Delivery[]
  documents         StockDocument[]
  reviews           Review[]
  payoutLines       AffiliatePayoutLine[]
  pick              OrderPick?

  @@index([status, createdAt])
  @@index([customerId])
  @@index([affiliateId, createdAt])
  @@index([uplineAffiliateId, createdAt])
  @@index([accountId, createdAt])
}

// ───────────────────────── Cộng tác viên (P10) ─────────────────────────

enum AffiliateSource {
  /// Khách bấm link giới thiệu (cookie 30 ngày, ai bấm sau cùng thì tính).
  LINK
  /// CTV tự lên đơn trong cổng /ctv.
  AFFILIATE
  /// Nhân viên gán CTV cho đơn.
  STAFF
}

model Affiliate {
  id               String                 @id @default(cuid())
  userId           String                 @unique
  user             User                   @relation(fields: [userId], references: [id])
  /// Mã giới thiệu (A–Z, 0–9), dùng trong link ?ref=CODE.
  code             String                 @unique
  phone            String
  /// % hoa hồng tính bằng phần vạn (1000 = 10%). Đổi chỉ áp dụng cho đơn mới (đơn chốt % lúc gắn).
  commissionRateBp Int
  /// Thông tin nhận tiền (ngân hàng / KBZPay / Wave…), chỉ để admin chuyển khoản.
  payoutInfo       String?
  active           Boolean                @default(true)
  /// % cấp trên này hưởng trên đơn của tuyến dưới (P13, phần vạn); null = dùng % chung trong Cài đặt.
  uplineRateBp     Int?
  /// Cấp trên trực tiếp (P11 — 2 tầng): người tuyển CTV này, hưởng % tầng trên trên đơn của CTV này.
  parentId         String?
  parent           Affiliate?             @relation("AffiliateTree", fields: [parentId], references: [id])
  children         Affiliate[]            @relation("AffiliateTree")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  orders           Order[]
  uplineOrders     Order[]                @relation("OrderUpline")
  payouts          AffiliatePayout[]
  invitations      AffiliateApplication[] @relation("ApplicationInviter")
  application      AffiliateApplication?  @relation("ApplicationAffiliate")

  @@index([parentId])
}

/// Một lần chi trả hoa hồng (tiền chuyển ngoài hệ thống, ở đây chỉ ghi nhận).
model AffiliatePayout {
  id          String                @id @default(cuid())
  affiliateId String
  affiliate   Affiliate             @relation(fields: [affiliateId], references: [id])
  amountMmk   Int
  note        String?
  proofFileId String?
  proofFile   FileObject?           @relation(fields: [proofFileId], references: [id])
  paidAt      DateTime              @default(now())
  createdById String
  createdAt   DateTime              @default(now())
  lines       AffiliatePayoutLine[]

  @@index([affiliateId, paidAt])
}

enum AffiliateLineKind {
  /// Hoa hồng bán hàng của CTV bán đơn.
  SALE
  /// Hoa hồng tầng trên (P11) của cấp trên trên đơn tuyến dưới.
  UPLINE
}

/// Số đã trả cho từng đơn trong một lần chi — chỉ ghi thêm. Có thể âm (khách trả hàng sau khi đã chi → trừ kỳ sau).
model AffiliatePayoutLine {
  id        String            @id @default(cuid())
  payoutId  String
  payout    AffiliatePayout   @relation(fields: [payoutId], references: [id])
  orderId   String
  order     Order             @relation(fields: [orderId], references: [id])
  kind      AffiliateLineKind @default(SALE)
  amountMmk Int

  @@index([orderId])
  @@index([payoutId])
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Đơn đăng ký làm CTV qua link mời (P11). Admin duyệt mới tạo tài khoản; mật khẩu băm bị xoá khi xử lý xong.
model AffiliateApplication {
  id           String            @id @default(cuid())
  inviterId    String
  inviter      Affiliate         @relation("ApplicationInviter", fields: [inviterId], references: [id])
  name         String
  phone        String
  email        String
  passwordHash String?
  status       ApplicationStatus @default(PENDING)
  note         String?
  reviewedById String?
  reviewedAt   DateTime?
  affiliateId  String?           @unique
  affiliate    Affiliate?        @relation("ApplicationAffiliate", fields: [affiliateId], references: [id])
  createdAt    DateTime          @default(now())

  @@index([status, createdAt])
  @@index([inviterId, status])
}

model OrderItem {
  id           String            @id @default(cuid())
  orderId      String
  order        Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId    String
  variant      Variant           @relation(fields: [variantId], references: [id])
  /// Snapshot lúc đặt.
  sku          String
  name         String
  qty          Int
  unitPriceMmk Int
  /// Số lượng khách đã trả lại (≤ qty). Doanh thu/giá vốn trừ phần này.
  returnedQty  Int               @default(0)
  /// Hoa hồng CTV cố định (MMK/cái) chốt lúc gắn CTV cho đơn; null = dòng tính theo % hoa hồng của đơn.
  commissionPerUnitMmk Int?
  allocations  OrderAllocation[]
  pickLines    OrderPickLine[]

  @@index([orderId])
  @@index([variantId])
}

/// D3-lite: phiếu soạn đã chốt khi in (manifest lô FEFO). KHÔNG giữ lô, không đổi tồn bán; khi bàn giao,
/// xuất đúng các dòng này nếu còn hợp lệ, lệch → báo in lại (không đổi lô âm thầm). In lại = thay toàn bộ dòng.
model OrderPick {
  orderId     String          @id
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  printedById String
  printedAt   DateTime        @default(now())
  /// Bàn giao đã xuất theo phiếu này.
  consumedAt  DateTime?
  lines       OrderPickLine[]
}

model OrderPickLine {
  id          String    @id @default(cuid())
  orderId     String
  pick        OrderPick @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  /// Biến thể thực lấy (combo → từng thành phần).
  variantId   String
  batchId     String
  batch       Batch     @relation(fields: [batchId], references: [id])
  locationId  String
  location    Location  @relation(fields: [locationId], references: [id])
  qty         Int

  @@index([orderId])
  @@index([batchId, locationId])
}

/// Phân lô khi bàn giao vận chuyển; giữ giá vốn để tính lợi nhuận.
model OrderAllocation {
  id                String    @id @default(cuid())
  orderItemId       String
  orderItem         OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  batchId           String
  batch             Batch     @relation(fields: [batchId], references: [id])
  qty               Int
  unitLandedCostMmk Int
  costStatus        CostStatus @default(MISSING)

  @@index([orderItemId])
  @@index([batchId])
}

enum CostStatus {
  ACTUAL
  ESTIMATED
  MISSING
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  userId     String?
  note       String?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
  @@index([toStatus, createdAt])
}

enum ProofStatus {
  PENDING
  APPROVED
  REJECTED
}

model PaymentProof {
  id           String      @id @default(cuid())
  orderId      String
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileId       String
  file         FileObject  @relation(fields: [fileId], references: [id])
  status       ProofStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  note         String?
  createdAt    DateTime    @default(now())

  @@index([orderId])
  @@index([status])
}

model Delivery {
  id         String    @id @default(cuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier    String
  trackingNo String?
  shippedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([orderId])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order        @relation(fields: [orderId], references: [id])
  rating    Int
  body      String?
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now())

  @@unique([productId, orderId])
  @@index([productId, status, createdAt])
  @@index([orderId])
}

// ───────────────────────── Nội dung trang chủ (P6) ─────────────────────────

/// Banner carousel trang chủ. Ảnh desktop 3:1, ảnh mobile 3:2 (không có thì dùng ảnh desktop).
model Banner {
  id            String      @id @default(cuid())
  desktopFileId String
  desktopFile   FileObject  @relation("BannerDesktop", fields: [desktopFileId], references: [id])
  mobileFileId  String?
  mobileFile    FileObject? @relation("BannerMobile", fields: [mobileFileId], references: [id])
  alt           String
  /// null = hiện cho mọi ngôn ngữ; "my" | "en" | "vi" khi ảnh có chữ theo ngôn ngữ.
  locale        String?
  /// Đường dẫn nội bộ (`/c/...`) hoặc URL `https://`.
  href          String?
  sortOrder     Int         @default(0)
  active        Boolean     @default(true)
  startAt       DateTime?
  endAt         DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([active, sortOrder])
}

/// Bộ sưu tập sản phẩm chọn tay (vd "Hàng mới về", "Thanh lý"). Không đổi giá.
model Collection {
  id           String                  @id @default(cuid())
  slug         String                  @unique
  sortOrder    Int                     @default(0)
  active       Boolean                 @default(true)
  showOnHome   Boolean                 @default(true)
  startAt      DateTime?
  endAt        DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  translations CollectionTranslation[]
  items        CollectionItem[]
}

model CollectionTranslation {
  collectionId String
  locale       String
  name         String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([collectionId, locale])
}

model CollectionItem {
  collectionId String
  productId    String
  sortOrder    Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
  @@index([productId])
}
