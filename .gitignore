# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.test

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# app
/storage
/storage-test
/test-results
/playwright-report
/playwright/.cache
/lighthouse-reports

# File CSV bản dịch xuất ra để gửi người duyệt (npm run i18n:export)
/i18n-export*.csv

# Previews and downloadable copies from the Excel template builder.
/outputs/catalog-import/
/outputs/vtp-export/

# Script phát hành cục bộ (đọc token GitHub lúc chạy) — không commit
scripts/github-release.mjs

# Bản sao lưu DB/ảnh local (không commit)
/backups
